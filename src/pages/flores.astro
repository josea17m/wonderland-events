function flowerPlaceholder(name) {
  return `<div class="card-img-placeholder">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2a4 4 0 014 4c0 1.5-.8 2.8-2 3.5M12 2a4 4 0 00-4 4c0 1.5.8 2.8 2 3.5M12 22a4 4 0 01-4-4c0-1.5.8-2.8 2-3.5M12 22a4 4 0 004-4c0-1.5-.8-2.8-2-3.5M2 12a4 4 0 014-4c1.5 0 2.8.8 3.5 2M2 12a4 4 0 004 4c1.5 0 2.8-.8 3.5-2M22 12a4 4 0 00-4-4c-1.5 0-2.8.8-3.5 2M22 12a4 4 0 01-4 4c-1.5 0-2.8-.8-3.5-2"/></svg>
    <span>${name}</span>
  </div>`;
}
const cardHTML = (item) => {
  const first = item.imagenes?.[0];
  const img = first
    ? `<img src="${first}" alt="${item.nombre}" loading="lazy">`
    : flowerPlaceholder(item.nombre);
  return `<div class="item-card" data-id="${item.id}">
    <div class="card-img">${img}</div>
    <div class="card-body">
      <p class="card-cat">${item.categoria}</p>
