<script>
const FLORES_DATA = [
  { id: 'f1', nombre: 'Arco Floral Campestre', categoria: 'Arcos Florales', precio_renta: 280, stock_total: 3, descripcion: 'Arco redondo cubierto con rosas, peonías y eucalipto. Ideal para bodas y sesiones fotográficas. Dimensiones: 2.40m × 2.40m.', imagen: 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=600&q=75&fit=crop' },
  { id: 'f2', nombre: 'Arco Media Luna', categoria: 'Arcos Florales', precio_renta: 320, stock_total: 2, descripcion: 'Semicírculo floral asimétrico con flores silvestres, ramas y follaje verde. Estructura de metal incluida.', imagen: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=600&q=75&fit=crop' },
  { id: 'f3', nombre: 'Arco Marquesina Blanco', categoria: 'Arcos Florales', precio_renta: 450, stock_total: 1, descripcion: 'Gran estructura rectangular con guirnaldas de flores blancas y hojas verdes. Elegante para ceremonias al aire libre.', imagen: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=600&q=75&fit=crop' },
  { id: 'f4', nombre: 'Centro Alto Cristal', categoria: 'Centros de Mesa', precio_renta: 85, stock_total: 20, descripcion: 'Jarrón de cristal alto con rosas, astromelias y greenery. Altura aproximada 70cm. Precio por unidad.', imagen: 'https://images.unsplash.com/photo-1533038590840-1cde6e668a91?w=600&q=75&fit=crop' },
  { id: 'f5', nombre: 'Centro Bajo Rústico', categoria: 'Centros de Mesa', precio_renta: 55, stock_total: 30, descripcion: 'Caja de madera con flores de temporada, suculentas y musgo. Perfecto para mesas largas estilo rústico o boho.', imagen: null },
  { id: 'f6', nombre: 'Centro Minimalista', categoria: 'Centros de Mesa', precio_renta: 45, stock_total: 25, descripcion: 'Florero cilíndrico negro con 3 tallos de flor exótica y follaje seco. Moderno y elegante para eventos contemporáneos.', imagen: null },
  { id: 'f7', nombre: 'Centro Cascada Novia', categoria: 'Centros de Mesa', precio_renta: 110, stock_total: 10, descripcion: 'Centro tipo cascada con rosas inglesas, lisianthus y wisteria colgante. Efecto dramático y romántico.', imagen: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&q=75&fit=crop' },
  { id: 'f8', nombre: 'Bouquet Novia Romántico', categoria: 'Bouquets', precio_renta: 120, stock_total: 5, descripcion: 'Ramo redondo compacto de rosas inglesas David Austin, peonías y eucalipto. Incluye cinta de raso.', imagen: 'https://images.unsplash.com/photo-1627556704302-624286467c65?w=600&q=75&fit=crop' },
  { id: 'f9', nombre: 'Bouquet Silvestre', categoria: 'Bouquets', precio_renta: 85, stock_total: 8, descripcion: 'Ramo asimétrico con flores de temporada, hierbas aromáticas y follaje silvestre. Estilo boho chic.', imagen: null },
  { id: 'f10', nombre: 'Bouquet Dama de Honor', categoria: 'Bouquets', precio_renta: 60, stock_total: 12, descripcion: 'Ramo pequeño coordinado con el bouquet de novia. Perfecto para el cortejo nupcial.', imagen: null },
  { id: 'f11', nombre: 'Corona Floral Cabeza', categoria: 'Coronas & Guirnaldas', precio_renta: 45, stock_total: 6, descripcion: 'Corona para la cabeza con flores frescas pequeñas y follaje delicado. Ideal para novias, quinceañeras y baby showers.', imagen: null },
  { id: 'f12', nombre: 'Guirnalda Eucalipto & Rosas', categoria: 'Coronas & Guirnaldas', precio_renta: 35, stock_total: 15, descripcion: 'Por metro lineal. Guirnalda de eucalipto natural con rosas intercaladas. Para decorar mesas, escaleras o entradas.', imagen: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=600&q=75&fit=crop' },
  { id: 'f13', nombre: 'Swag Floral para Silla', categoria: 'Coronas & Guirnaldas', precio_renta: 22, stock_total: 40, descripcion: 'Decoración floral para el respaldo de sillas. Incluye cinta y flor central. Precio por unidad.', imagen: null },
  { id: 'f14', nombre: 'Camino de Pétalos Rosas', categoria: 'Pétalos & Suelos', precio_renta: 75, stock_total: 10, descripcion: 'Camino de pétalos de rosa natural para la entrada de la ceremonia. Longitud 10m. Colores personalizables.', imagen: null },
  { id: 'f15', nombre: 'Alfombra Floral Bebé', categoria: 'Pétalos & Suelos', precio_renta: 140, stock_total: 3, descripcion: 'Composición floral en el suelo tipo "flower floor" para fotos. 2m × 1.5m con flores variadas y hojas.', imagen: 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=600&q=75&fit=crop' },
  { id: 'f16', nombre: 'Jarrón Vintage Bronce', categoria: 'Accesorios', precio_renta: 18, stock_total: 20, descripcion: 'Jarrón estilo vintage en tono bronce envejecido. No incluye flores. Ideal para uso decorativo o con flores secas.', imagen: null },
  { id: 'f17', nombre: 'Florero de Cristal Burbuja', categoria: 'Accesorios', precio_renta: 12, stock_total: 30, descripcion: 'Florero esférico de cristal soplado. No incluye flores. Perfecto como elemento decorativo o porta velas flotantes.', imagen: null },
  { id: 'f18', nombre: 'Caja Madera para Flores', categoria: 'Accesorios', precio_renta: 15, stock_total: 18, descripcion: 'Caja rectangular de madera pintada en blanco. No incluye flores. Uso como base para centros de mesa o arreglos.', imagen: null },
];

const WHATSAPP_NUMBER = '10000000000';
let allItems = [...FLORES_DATA], filtered = [...FLORES_DATA], activeCategory = 'all', searchTerm = '';
let cart = {}, currentItem = null, currentQty = 1;

function init() { applyFilters(); }

document.getElementById('catsContainer').addEventListener('click', e => {
  const chip = e.target.closest('.cat-chip');
  if (!chip) return;
  document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
  chip.classList.add('active');
  activeCategory = chip.dataset.cat;
  applyFilters();
});

document.getElementById('searchInput').addEventListener('input', e => {
  searchTerm = e.target.value.toLowerCase().trim();
  applyFilters();
});

function applyFilters() {
  filtered = allItems.filter(item => {
    const mc = activeCategory === 'all' || item.categoria === activeCategory;
    const ms = !searchTerm || [item.nombre, item.descripcion, item.categoria].some(v => v?.toLowerCase().includes(searchTerm));
    return mc && ms;
  });
  renderGrid();
  document.getElementById('resultsCount').textContent = `${filtered.length} artículo${filtered.length !== 1 ? 's' : ''}`;
}

function renderGrid() {
  const grid = document.getElementById('catalogGrid');
  if (!filtered.length) {
    grid.innerHTML = '<div class="state-msg"><p>Sin resultados</p><small>Prueba otra búsqueda o categoría</small></div>';
    return;
  }
  grid.innerHTML = filtered.map(item => cardHTML(item)).join('');
  grid.querySelectorAll('.item-card').forEach(card => {
    card.addEventListener('click', e => {
      const id = card.dataset.id;
      if (e.target.closest('.card-add')) { e.stopPropagation(); toggleCartItem(id, 1); return; }
      openModal(id);
    });
  });
  updateCardStates();
}

function flowerPlaceholder(name) {
  return `<div class="card-img-placeholder">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2a4 4 0 014 4c0 1.5-.8 2.8-2 3.5M12 2a4 4 0 00-4 4c0 1.5.8 2.8 2 3.5M12 22a4 4 0 01-4-4c0-1.5.8-2.8 2-3.5M12 22a4 4 0 004-4c0-1.5-.8-2.8-2-3.5M2 12a4 4 0 014-4c1.5 0 2.8.8 3.5 2M2 12a4 4 0 004 4c1.5 0 2.8-.8 3.5-2M22 12a4 4 0 00-4-4c-1.5 0-2.8.8-3.5 2M22 12a4 4 0 01-4 4c-1.5 0-2.8-.8-3.5-2"/></svg>
    <span>${name}</span>
  </div>`;
}

function cardHTML(item) {
  const img = item.imagen
    ? `<img src="${item.imagen}" alt="${item.nombre}" loading="lazy">`
    : flowerPlaceholder(item.nombre);
  return `<div class="item-card" data-id="${item.id}">
    <div class="card-img">${img}</div>
    <div class="card-body">
      <p class="card-cat">${item.categoria}</p>
      <h3 class="card-name">${item.nombre}</h3>
      <p class="card-desc">${item.descripcion}</p>
      <div class="card-footer">
        <div class="card-price">$${Number(item.precio_renta).toLocaleString()} <span>/ renta</span></div>
        <button class="card-add" data-id="${item.id}">+ Agregar</button>
      </div>
    </div>
  </div>`;
}

function updateCardStates() {
  document.querySelectorAll('.item-card').forEach(card => {
    const id = card.dataset.id;
    const inCart = !!cart[id];
    card.classList.toggle('in-cart', inCart);
    const btn = card.querySelector('.card-add');
    if (btn) { btn.textContent = inCart ? '✓ Agregado' : '+ Agregar'; btn.classList.toggle('added', inCart); }
  });
}

function openModal(id) {
  currentItem = allItems.find(i => String(i.id) === String(id));
  if (!currentItem) return;
  currentQty = cart[id]?.qty || 1;
  const img = currentItem.imagen
    ? `<img src="${currentItem.imagen}" alt="${currentItem.nombre}">`
    : `<div style="height:100%;display:flex;align-items:center;justify-content:center;">${flowerPlaceholder(currentItem.nombre)}</div>`;
  document.getElementById('modalImg').innerHTML = img;
  document.getElementById('modalCat').textContent = currentItem.categoria;
  document.getElementById('modalName').textContent = currentItem.nombre;
  document.getElementById('modalPrice').innerHTML = `$${Number(currentItem.precio_renta).toLocaleString()} <small>/ renta</small>`;
  document.getElementById('modalStock').textContent = `Disponibilidad: ${currentItem.stock_total} unidades`;
  document.getElementById('modalDesc').textContent = currentItem.descripcion;
  document.getElementById('qtyDisplay').textContent = currentQty;
  const inCart = !!cart[id];
  const btn = document.getElementById('modalAddBtn');
  btn.textContent = inCart ? '✓ En cotización' : 'Agregar a cotización';
  btn.classList.toggle('added', inCart);
  document.getElementById('modalBackdrop').classList.add('open');
  document.body.style.overflow = 'hidden';
}

document.getElementById('modalClose').addEventListener('click', closeModal);
document.getElementById('modalBackdrop').addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });
function closeModal() { document.getElementById('modalBackdrop').classList.remove('open'); document.body.style.overflow = ''; currentItem = null; }

document.getElementById('qtyMinus').addEventListener('click', () => { if (currentQty > 1) { currentQty--; document.getElementById('qtyDisplay').textContent = currentQty; } });
document.getElementById('qtyPlus').addEventListener('click', () => { if (currentQty < (currentItem?.stock_total || 99)) { currentQty++; document.getElementById('qtyDisplay').textContent = currentQty; } });
document.getElementById('modalAddBtn').addEventListener('click', () => {
  if (!currentItem) return;
  toggleCartItem(String(currentItem.id), currentQty);
  const inCart = !!cart[String(currentItem.id)];
  document.getElementById('modalAddBtn').textContent = inCart ? '✓ En cotización' : 'Agregar a cotización';
  document.getElementById('modalAddBtn').classList.toggle('added', inCart);
});

function toggleCartItem(id, qty) {
  if (cart[id]) { delete cart[id]; }
  else { const item = allItems.find(i => String(i.id) === String(id)); if (item) cart[id] = { item, qty: qty || 1 }; }
  updateCartUI(); updateCardStates();
}

function updateCartUI() {
  const ids = Object.keys(cart), count = ids.length;
  const countEl = document.getElementById('cartCount');
  countEl.textContent = count;
  countEl.classList.toggle('visible', count > 0);
  const itemsEl = document.getElementById('cartItems');
  const totalRow = document.getElementById('cartTotalRow');
  if (!count) { itemsEl.innerHTML = '<p class="cart-empty">Aún no has agregado flores.<br>¡Explora nuestros arreglos!</p>'; totalRow.style.display = 'none'; return; }
  let total = 0;
  itemsEl.innerHTML = ids.map(id => {
    const { item, qty } = cart[id];
    const sub = Number(item.precio_renta) * qty;
    total += sub;
    const img = item.imagen ? `<img src="${item.imagen}" alt="${item.nombre}">` : '';
    return `<div class="cart-item" data-id="${id}">
      <div class="ci-img">${img}</div>
      <div class="ci-info">
        <p class="ci-cat">${item.categoria}</p>
        <p class="ci-name">${item.nombre}</p>
        <div class="ci-qty-row">
          <button class="ci-qty-btn ci-minus">−</button>
          <span class="ci-qty">${qty}</span>
          <button class="ci-qty-btn ci-plus">+</button>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
        <p class="ci-price">$${sub.toLocaleString()}</p>
        <button class="ci-remove">✕</button>
      </div>
    </div>`;
  }).join('');
  totalRow.style.display = 'flex';
  document.getElementById('cartTotalVal').textContent = `$${total.toLocaleString()}`;
  itemsEl.querySelectorAll('.cart-item').forEach(row => {
    const id = row.dataset.id;
    row.querySelector('.ci-remove').addEventListener('click', () => { delete cart[id]; updateCartUI(); updateCardStates(); });
    row.querySelector('.ci-minus').addEventListener('click', () => { if (cart[id].qty > 1) { cart[id].qty--; updateCartUI(); } });
    row.querySelector('.ci-plus').addEventListener('click', () => { cart[id].qty++; updateCartUI(); });
  });
}

document.getElementById('openCartBtn').addEventListener('click', openCart);
document.getElementById('cartClose').addEventListener('click', closeCart);
document.getElementById('cartOverlay').addEventListener('click', closeCart);
function openCart() { document.getElementById('cartPanel').classList.add('open'); document.getElementById('cartOverlay').classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeCart() { document.getElementById('cartPanel').classList.remove('open'); document.getElementById('cartOverlay').classList.remove('open'); document.body.style.overflow = ''; }

document.getElementById('sendQuoteBtn').addEventListener('click', () => {
  const n = document.getElementById('fNombre').value.trim();
  const t = document.getElementById('fTelefono').value.trim();
  const c = document.getElementById('fCorreo').value.trim();
  if (!n || !t || !c) { alert('Por favor llena nombre, teléfono y correo.'); return; }
  document.querySelector('.quote-actions').style.display = 'none';
  document.getElementById('successMsg').classList.add('show');
  setTimeout(() => {
    document.getElementById('successMsg').classList.remove('show');
    document.querySelector('.quote-actions').style.display = 'flex';
    cart = {}; updateCartUI(); updateCardStates(); closeCart();
  }, 3000);
});

document.getElementById('whatsappBtn').addEventListener('click', () => {
  const nombre = document.getElementById('fNombre').value.trim() || 'Cliente';
  const ids = Object.keys(cart);
  if (!ids.length) { alert('Agrega flores a tu cotización primero.'); return; }
  const items = ids.map(id => { const { item, qty } = cart[id]; return `• ${item.nombre} x${qty} — $${(Number(item.precio_renta)*qty).toLocaleString()}`; }).join('\n');
  const msg = `Hola! Soy *${nombre}* y me interesa cotizar flores:\n\n${items}\n\nFecha: ${document.getElementById('fFecha').value || 'Por definir'}\n${document.getElementById('fNotas').value || ''}`;
  window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`, '_blank');
});

const hb = document.getElementById('hamburger'), mm = document.getElementById('mobileMenu');
hb.addEventListener('click', () => { hb.classList.toggle('open'); mm.classList.toggle('open'); });
mm.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { hb.classList.remove('open'); mm.classList.remove('open'); }));

init();
</script>
</body>
</html>
