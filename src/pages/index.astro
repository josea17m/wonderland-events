---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Wonderland Events — Rentals & Decoration"
  description="Wonderland Events — Rentals y decoración para bodas, baby showers, graduaciones y eventos temáticos. Transformamos espacios en momentos inolvidables."
  bodyClass="bg-parchment-3 text-ink font-sans font-light overflow-x-hidden"
>
<style>
/* catalog item inner border decoration */
.catalog-item::before {
  content: '';
  position: absolute; top: 8px; left: 8px; right: 8px; bottom: 8px;
  border: 1px solid rgba(184,137,46,0.1);
  pointer-events: none; transition: border-color 0.25s;
}
.catalog-item:hover::before { border-color: rgba(192,134,143,0.2); }

/* why-visual inner border */
.why-visual::before {
  content: ''; position: absolute; inset: 8px;
  border: 1px solid rgba(184,137,46,0.12); pointer-events: none; z-index: 1;
}


/* services bar accent lines */
#services::before { top: 0; }
#services::after  { bottom: 0; }
#services::before, #services::after {
  content: ''; position: absolute; left: 0; right: 0; height: 1px;
  background: linear-gradient(to right, transparent, rgba(184,137,46,0.4) 30%, rgba(184,137,46,0.4) 70%, transparent);
}

/* service pill separator */
.service-pill + .service-pill::before {
  content: '✦';
  position: absolute; left: 0; top: 50%; transform: translate(-50%, -50%);
  color: #D4A84B; font-size: 9px; opacity: 0.6;
}

/* ── Smooth animations ─────────────────────────────────────── */
/* Portfolio: animate scale + transform (Tailwind v4 uses scale property) */
#portfolio .group img {
  will-change: scale, transform;
  transition:
    scale     550ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
    transform 550ms cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
}

/* Catalog cards: cover both translate and transform */
.catalog-item {
  will-change: translate, transform;
  transition:
    border-color 200ms ease,
    box-shadow   320ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
    translate    280ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
    transform    280ms cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
}
.catalog-item:hover {
  translate: 0 -7px !important;
  transform: translateY(-7px) !important;
}

/* CTA buttons */
nav a[href="#contact"], #hero a {
  transition:
    background-color 220ms cubic-bezier(0.4, 0, 0.2, 1),
    color        220ms ease,
    border-color 220ms ease !important;
}

/* ── Vintage letter form ──────────────────────────────────── */
.letter-label {
  font-family: 'Cormorant SC', Georgia, serif;
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: #7D5A3C;
  display: block;
  margin-bottom: 14px;
  opacity: 0.85;
}
.letter-input {
  background: transparent;
  border: none;
  border-bottom: 1px solid rgba(125, 90, 60, 0.4);
  width: 100%;
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-style: italic;
  font-size: 22px;
  font-weight: 300;
  color: #3F2718;
  outline: none;
  padding: 10px 0;
  transition: border-bottom-color 250ms ease;
  -webkit-appearance: none;
  appearance: none;
}
.letter-input::placeholder {
  color: rgba(125, 90, 60, 0.45);
  font-style: italic;
}
.letter-input:hover  { border-bottom-color: rgba(125, 90, 60, 0.65); }
.letter-input:focus  { border-bottom-color: rgba(154, 95, 104, 0.85); }
textarea.letter-input {
  resize: none;
  display: block;
  line-height: 1.7;
  min-height: 130px;
}
/* Date input dark text */
.letter-input[type="date"] { color-scheme: light; }

@media (max-width: 600px) {
  .letter-input { font-size: 18px; }
  .letter-label { font-size: 11px; letter-spacing: 0.25em; margin-bottom: 10px; }
}
</style>
<Fragment slot="nav">
  <Nav currentPage="home" />
</Fragment>

