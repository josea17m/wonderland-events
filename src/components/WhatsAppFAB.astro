---
interface Props {
  phone: string;
  message?: string;
  ariaLabel?: string;
}

const {
  phone,
  message = "Hola! Me interesa cotizar un evento.",
  ariaLabel = "Contactar por WhatsApp",
} = Astro.props;

const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={ariaLabel}
  class="fixed bottom-6 right-6 z-[150] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg transition-transform hover:scale-110 hover:bg-[#1ebe5d]"
>
  <svg viewBox="0 0 24 24" class="h-7 w-7 fill-white" aria-hidden="true">
